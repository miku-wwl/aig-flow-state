# Documentation only; environment variables are read by safeops (no dotenv dependency).
SAFEOPS_STATE=.runtime/local
SAFEOPS_PROVIDER=ollama
SAFEOPS_OLLAMA_URL=http://127.0.0.1:11434
SAFEOPS_MODEL=phi4-mini:latest
SAFEOPS_MODEL_TIMEOUT=28
SAFEOPS_ENFORCEMENT_MODE=mock
# Choices: mock (default), sdk-only, proxy; real remains the legacy proxy alias.
# LIVE modes use the existing ArmorIQ CLI credential store or ARMORIQ_API_KEY.
# SDK-only needs no public MCP. Provision NEW state and local keys with init + init-live.
# SAFEOPS_ARMORIQ_USER_EMAIL can override the existing CLI operator email.
# SAFEOPS_MCP_BEARER is used only by CLI config validation/registration, loaded privately.
# Never add capability contents here. Load the private capability file through the browser picker.
